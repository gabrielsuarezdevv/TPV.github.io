@model tpv.Models.Pedido

@{
    Layout = null;
    var lineas = ViewBag.Lineas as IEnumerable<tpv.Models.LineaPedido>;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Ticket #@Model.Id</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Courier New', Courier, monospace;
            font-size: 12px;
            background: #fff;
            color: #000;
            width: 76mm;
            margin: 0 auto;
            padding: 3mm 0;
        }

        .ticket {
            width: 100%;
            padding: 0 4mm;
        }

        /* ── CABECERA ── */
        .header {
            text-align: center;
            border-bottom: 1px dashed #000;
            padding-bottom: 6px;
            margin-bottom: 6px;
        }

        .brand {
            font-size: 22px;
            font-weight: bold;
            letter-spacing: 4px;
            text-transform: uppercase;
        }

        .header-sub {
            font-size: 11px;
            margin-top: 2px;
            color: #333;
        }

        .header-date {
            font-size: 11px;
            margin-top: 4px;
        }

        .ticket-num {
            font-size: 11px;
            font-weight: bold;
            margin-top: 2px;
        }

        /* ── SEPARADORES ── */
        .sep-solid { border-top: 1px solid #000; margin: 5px 0; }
        .sep-dash  { border-top: 1px dashed #000; margin: 5px 0; }

        /* ── CABECERA TABLA ── */
        .col-header {
            display: flex;
            justify-content: space-between;
            font-size: 11px;
            font-weight: bold;
            text-transform: uppercase;
            padding: 2px 0;
        }

        .col-header .ch-desc { flex: 1; min-width: 0; overflow: hidden; }
        .col-header .ch-cant { width: 20px; text-align: center; }
        .col-header .ch-pu   { width: 42px; text-align: right; }
        .col-header .ch-tot  { width: 48px; text-align: right; }

        /* ── LÍNEAS ── */
        .linea {
            margin-bottom: 3px;
        }

        .linea-main {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
        }

        .l-nombre {
            flex: 1;
            min-width: 0;
            font-size: 11px;
            font-weight: bold;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            padding-right: 3px;
        }

        .l-cant {
            width: 20px;
            text-align: center;
            font-size: 11px;
            flex-shrink: 0;
        }

        .l-pu {
            width: 42px;
            text-align: right;
            font-size: 11px;
            color: #444;
            flex-shrink: 0;
        }

        .l-total {
            width: 48px;
            text-align: right;
            font-size: 11px;
            font-weight: bold;
            flex-shrink: 0;
        }

        /* ── TOTALES ── */
        .totales { padding: 2px 0; }

        .total-row {
            display: flex;
            justify-content: space-between;
            font-size: 11px;
            padding: 1px 0;
        }

        .total-row .t-label { color: #333; }
        .total-row .t-value { font-weight: bold; }

        .total-final {
            display: flex;
            justify-content: space-between;
            font-size: 15px;
            font-weight: bold;
            padding: 4px 0 2px;
        }

        /* ── IVA INFO ── */
        .iva-row {
            display: flex;
            justify-content: space-between;
            font-size: 9px;
            color: #333;
            padding: 1px 0;
        }

        /* ── PIE ── */
        .footer {
            text-align: center;
            border-top: 1px dashed #000;
            padding-top: 6px;
            margin-top: 6px;
            font-size: 10px;
            color: #333;
            line-height: 1.5;
        }

        .footer-thanks {
            font-size: 12px;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 3px;
        }

        /* ── BOTONES (solo pantalla, no impresión) ── */
        .print-actions {
            width: 80mm;
            margin: 8mm auto 0;
            display: flex;
            gap: 4mm;
        }

        .btn-print, .btn-close {
            flex: 1;
            padding: 8px;
            font-size: 13px;
            font-weight: bold;
            cursor: pointer;
            border: none;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .btn-print { background: #8d000a; color: #fff; }
        .btn-print:hover { background: #6a0007; }
        .btn-close { background: #e0dbd4; color: #1a1410; }
        .btn-close:hover { background: #ccc7be; }

        /* ── PRINT MEDIA ── */
        @@page {
            margin: 0mm 2mm;
            padding: 0;
            size: 80mm auto;
        }

        @@media print {
            .print-actions { display: none; }
            html, body { width: 76mm; margin: 0; padding: 0; height: auto !important; }
            .ticket { padding-bottom: 4mm; }
        }
    </style>
</head>
<body>

<div class="ticket">

    <!-- CABECERA -->
    <div class="header">
        <div class="brand">VETERINARIA SUAREZ</div>
        <div class="header-sub">C/ Tempranillo · Sanlucar de Barrameda</div>
        <div class="header-sub">Tel: 622 444 104</div>
        <div class="sep-dash" style="margin:4px 0;"></div>
        <div class="header-date">@Model.Fecha.ToString("dd/MM/yyyy  HH:mm:ss")</div>
        <div class="ticket-num">TICKET Nº @Model.Id.ToString("D6")</div>
    </div>

    <!-- CABECERA COLUMNAS -->
    <div class="col-header">
        <span class="ch-desc">DESCRIPCIÓN</span>
        <span class="ch-cant">UD</span>
        <span class="ch-pu">P.U.</span>
        <span class="ch-tot">TOTAL</span>
    </div>
    <div class="sep-dash"></div>

    <!-- LÍNEAS DE PEDIDO -->
    @if (lineas != null)
    {
        @foreach (var linea in lineas)
        {
            decimal subtotal = linea.Producto.Precio * linea.Cantidad;
            <div class="linea">
                <div class="linea-main">
                    <span class="l-nombre" title="@linea.Producto.Nombre">@linea.Producto.Nombre.ToUpper()</span>
                    <span class="l-cant">@linea.Cantidad</span>
                    <span class="l-pu">@linea.Producto.Precio.ToString("N2")€</span>
                    <span class="l-total">@subtotal.ToString("N2")€</span>
                </div>
            </div>
        }
    }

    <div class="sep-dash"></div>

    <!-- TOTALES -->
    <div class="totales">

        @if (Model.Descuento > 0)
        {
            <div class="total-row">
                <span class="t-label">SUBTOTAL</span>
                <span class="t-value">@Model.TotalSinDescuento.ToString("N2")€</span>
            </div>
            <div class="total-row">
                <span class="t-label">DESCUENTO (@Model.Descuento%)</span>
                <span class="t-value">-@((Model.TotalSinDescuento - Model.Total).ToString("N2"))€</span>
            </div>
            <div class="sep-dash"></div>
        }

        <div class="total-final">
            <span>TOTAL</span>
            <span>@Model.Total.ToString("N2")€</span>
        </div>

    </div>

    <div class="sep-dash"></div>

    <!-- DESGLOSE IVA -->
    @{
        decimal baseImponible = Math.Round(Model.Total / 1.21m, 2);
        decimal iva = Model.Total - baseImponible;
    }
    <div class="iva-row">
        <span>BASE IMPONIBLE (21% IVA)</span>
        <span>@baseImponible.ToString("N2")€</span>
    </div>
    <div class="iva-row">
        <span>IVA 21%</span>
        <span>@iva.ToString("N2")€</span>
    </div>

    <!-- PIE -->
    <div class="footer">
        <div class="footer-thanks">¡Gracias por su visita!</div>
        <div>Conserve este ticket</div>
        <div>www.veterinariasuarez.es</div>
    </div>

</div>

<!-- BOTONES (no se imprimen) -->
<div class="print-actions">
    <button class="btn-print" onclick="window.print()">🖨 IMPRIMIR</button>
    <button class="btn-close" onclick="window.close()">✕ CERRAR</button>
</div>

<script>
    // Imprimir automáticamente al abrir
    window.addEventListener('load', function () {
        // Pequeño delay para que cargue bien antes de imprimir
        setTimeout(() => window.print(), 500);
    });
</script>

</body>
</html>
