@model IEnumerable<tpv.Models.Pedido>

@{
}
<h1>Historial de Pedidos</h1>

<table class="table">
    <tr>
        <th>ID</th>
        <th>Fecha</th>
        <th>Total</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Fecha</td>
            <td>@item.Total</td>
        </tr>
    }
</table>